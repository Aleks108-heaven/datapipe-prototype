{
  "name": "products_buyers_preferences",
  "version": 1,
  "columns": [
    {"name": "order_id", "type": "string", "required": true, "unique": true, "pattern": "ORD[0-9]{6,}", "description": "One order line"},
    {"name": "order_date", "type": "date", "required": true, "format": "%Y-%m-%d"},
    {"name": "order_time", "type": "string", "pattern": "([01][0-9]|2[0-3]):[0-5][0-9]", "description": "HH:MM"},
    {"name": "channel", "type": "string", "required": true, "allowed": ["Web", "Mobile App", "In-Store"]},
    {"name": "payment_method", "type": "string", "required": true, "allowed": ["Card", "PayPal", "Bank Transfer", "Cash on Delivery"]},
    {"name": "order_status", "type": "string", "required": true, "allowed": ["Processing", "Shipped", "Delivered", "Returned", "Cancelled"]},
    {"name": "quantity", "type": "decimal", "scale": 2, "required": true, "min": "0.01", "description": "Pieces, or kg for produce"},
    {"name": "currency", "type": "string", "required": true, "allowed": ["EUR", "GBP", "RON", "PLN"]},
    {"name": "shipping_method", "type": "string", "required": true, "allowed": ["Standard", "Express", "Pickup"]},
    {"name": "delivery_days", "type": "integer", "min": 0, "max": 60},
    {"name": "product_id", "type": "string", "required": true, "pattern": "[EP][0-9]{4}"},
    {"name": "sku", "type": "string", "required": true, "max_length": 40},
    {"name": "product_name", "type": "string", "required": true, "max_length": 80},
    {"name": "product_group", "type": "string", "required": true, "allowed": ["Electrical", "Produce"]},
    {"name": "category", "type": "string", "required": true, "max_length": 40},
    {"name": "subcategory", "type": "string", "max_length": 40},
    {"name": "brand", "type": "string", "max_length": 40},
    {"name": "unit_of_measure", "type": "string", "required": true, "allowed": ["piece", "kg"]},
    {"name": "unit_price", "type": "decimal", "scale": 2, "required": true, "min": "0.01", "description": "Before discount and tax"},
    {"name": "discount_pct", "type": "integer", "min": 0, "max": 100},
    {"name": "tax_rate_pct", "type": "integer", "min": 0, "max": 40},
    {"name": "line_total", "type": "decimal", "scale": 2, "required": true, "min": "0", "description": "quantity x unit_price x (1 - discount) x (1 + tax), rounded to cents"},
    {"name": "stock_on_hand", "type": "integer", "min": 0},
    {"name": "product_rating", "type": "decimal", "scale": 1, "min": "0", "max": "5"},
    {"name": "is_organic", "type": "boolean"},
    {"name": "power_watts", "type": "integer", "min": 0},
    {"name": "voltage_v", "type": "integer", "min": 0},
    {"name": "warranty_months", "type": "integer", "min": 0},
    {"name": "energy_class", "type": "string", "allowed": ["A", "B", "C", "D", "E", "F", "G"]},
    {"name": "shelf_life_days", "type": "integer", "min": 0},
    {"name": "is_seasonal", "type": "boolean"},
    {"name": "buyer_id", "type": "string", "required": true, "pattern": "[A-Z][0-9]{5}", "description": "Pseudonymous buyer key"},
    {"name": "buyer_name", "type": "string", "pii": true, "max_length": 80},
    {"name": "gender", "type": "string", "allowed": ["F", "M", "Other", "Undisclosed"]},
    {"name": "age", "type": "integer", "min": 16, "max": 110},
    {"name": "age_group", "type": "string", "required": true, "allowed": ["18-24", "25-34", "35-44", "45-54", "55-64", "65+"]},
    {"name": "country", "type": "string", "required": true, "max_length": 40},
    {"name": "city", "type": "string", "pii": true, "max_length": 60},
    {"name": "income_band", "type": "string", "allowed": ["<20k", "20-40k", "40-70k", "70-100k", ">100k"]},
    {"name": "buyer_type", "type": "string", "allowed": ["Individual", "Household", "Small Business", "Restaurant", "Retailer"]},
    {"name": "loyalty_tier", "type": "string", "allowed": ["None", "Bronze", "Silver", "Gold", "Platinum"]},
    {"name": "signup_date", "type": "date", "format": "%Y-%m-%d"},
    {"name": "household_size", "type": "integer", "min": 1, "max": 30},
    {"name": "has_children", "type": "boolean"},
    {"name": "pref_product_group", "type": "string", "allowed": ["Electrical", "Produce", "Both"]},
    {"name": "pref_organic", "type": "boolean"},
    {"name": "pref_price_sensitivity", "type": "string", "allowed": ["Low", "Medium", "High"]},
    {"name": "pref_brand_loyalty_score", "type": "decimal", "scale": 1, "min": "0", "max": "10"},
    {"name": "pref_eco_friendly", "type": "boolean"},
    {"name": "pref_delivery", "type": "string", "allowed": ["Standard", "Express", "Pickup"]},
    {"name": "pref_payment", "type": "string", "allowed": ["Card", "PayPal", "Bank Transfer", "Cash on Delivery"]},
    {"name": "pref_channel", "type": "string", "allowed": ["Web", "Mobile App", "In-Store"]},
    {"name": "pref_tech_savviness", "type": "integer", "min": 1, "max": 5},
    {"name": "pref_dietary", "type": "string", "allowed": ["None", "Vegetarian", "Vegan", "Gluten-free", "Halal", "Keto"]},
    {"name": "pref_energy_efficiency_importance", "type": "integer", "min": 1, "max": 5},
    {"name": "newsletter_optin", "type": "boolean"},
    {"name": "churn_risk", "type": "decimal", "scale": 2, "min": "0", "max": "1"},
    {"name": "buyer_lifetime_value", "type": "decimal", "scale": 2, "min": "0"},
    {"name": "return_flag", "type": "boolean"},
    {"name": "review_score", "type": "integer", "min": 1, "max": 5}
  ]
}
